{
  "type": "object",
  "properties": {
    "allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unitId": {
            "type": "string",
            "description": "설계자가 새로 구성한 출제 묶음의 고유 ID이다. 원래 목차 단락 ID와 같을 필요가 없다."
          },
          "conceptIds": {
            "type": "array",
            "description": "이 묶음의 출제에 함께 필요한 catalog의 개념 ID이다. 관련된 여러 단락의 개념을 포함할 수 있다.",
            "items": {
              "type": "string"
            }
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "conceptIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "goal": {
                  "type": "object",
                  "properties": {
                    "given": {
                      "type": "string",
                      "description": "학생에게 제공할 필수 자료·조건의 짧은 명세. 판단의 답이나 풀이를 쓰지 않는다. 단순 회상이면 빈 문자열이다."
                    },
                    "judgment": {
                      "type": "string",
                      "description": "한 문항에서 확인할 핵심 사실·관계·조건의 구별 기준. 자료 목록이나 예시 요약이 아니다."
                    },
                    "confusion": {
                      "type": "string",
                      "description": "그 기준에서 구별할 잘못된 이해나 대응. 직접 회상 과제이면 빈 문자열도 허용한다. 학생 통계로 검증됐다는 뜻은 아니다."
                    }
                  },
                  "required": [
                    "given",
                    "judgment",
                    "confusion"
                  ],
                  "additionalProperties": false
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "ox",
                    "mcq",
                    "word",
                    "essay"
                  ]
                },
                "profile": {
                  "type": "string",
                  "enum": [
                    "general",
                    "advanced"
                  ]
                },
                "additionalJudgment": {
                  "type": "string"
                },
                "profileEvidenceSourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "type",
                "conceptIds",
                "goal",
                "profile",
                "additionalJudgment",
                "profileEvidenceSourceIds"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "unitId",
          "conceptIds",
          "targets"
        ],
        "additionalProperties": false
      }
    },
    "unallocated": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "type": "string"
    },
    "customTypeRatio": {
      "type": "boolean"
    }
  },
  "required": [
    "allocations",
    "unallocated",
    "reason",
    "customTypeRatio"
  ],
  "additionalProperties": false
}
